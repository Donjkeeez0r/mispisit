{{> header}}
<h1>Рейтинг отдела продаж</h1>
<table>
  <tr><th>Место</th><th>Сотрудник</th><th>Уровень</th><th>Опыт (XP)</th></tr>
  {{#each rows}}
  <tr>
    <td>{{place}}</td>
    <td><a href="/employees/{{id}}">{{name}}</a></td>
    <td>{{level}}</td>
    <td>{{xp}}</td>
  </tr>
  {{else}}
  <tr><td colspan="4">Пока никого нет. Сотрудник появится в рейтинге после первого начисления опыта.</td></tr>
  {{/each}}
</table>
{{> footer}}