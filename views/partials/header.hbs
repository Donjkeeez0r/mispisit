<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} — SalesDrive</title>
  <link rel="stylesheet" href="/static/bootstrap/css/bootstrap.min.css">
  <style>
    body { background: #f3f5f9; }
    .navbar-brand { font-weight: 700; letter-spacing: .3px; }
    .stat-value { font-size: 2rem; font-weight: 700; line-height: 1.1; }
    .empty-state { padding: 3rem 1rem; text-align: center; color: #6c757d; }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-md navbar-dark bg-primary shadow-sm">
  <div class="container">
    <a class="navbar-brand" href="/">SalesDrive <span class="badge bg-light text-primary ms-1">v0.0.4</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link {{#if (eq nav 'home')}}active{{/if}}" href="/">Главная</a></li>
        <li class="nav-item"><a class="nav-link {{#if (eq nav 'leaderboard')}}active{{/if}}" href="/leaderboard">Рейтинг</a></li>
        <li class="nav-item"><a class="nav-link {{#if (eq nav 'new')}}active{{/if}}" href="/events/new">Начислить опыт</a></li>
        <li class="nav-item"><a class="nav-link {{#if (eq nav 'rejected')}}active{{/if}}" href="/events/rejected">Отклонённые события</a></li>
      </ul>
    </div>
  </div>
</nav>
<main class="container my-4 flex-grow-1">