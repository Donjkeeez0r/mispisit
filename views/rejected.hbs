{{> header}}
<h1 class="h3 mb-3">Отклонённые события</h1>
{{#if last}}
<div class="alert alert-danger shadow-sm" role="alert">
  <h2 class="h5 alert-heading">Событие не принято</h2>
  <p class="mb-1"><b>Сотрудник:</b> {{last.employeeName}}</p>
  <p class="mb-1"><b>Событие:</b> {{last.typeLabel}}, ID в CRM: <code>{{last.crmId}}</code></p>
  <p class="mb-2"><b>Причина:</b> {{last.reason}}</p>
  <hr>
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <small>{{last.date}}</small>
    <a href="/events/new" class="btn btn-sm btn-outline-danger">Вернуться к форме</a>
  </div>
</div>
{{else}}
<div class="card shadow-sm">
  <div class="empty-state">
    <h2 class="h5">Отклонённых событий пока нет</h2>
    <p class="mb-0">Здесь появятся события, которые система не приняла: повторные или с незаполненными полями.</p>
  </div>
</div>
{{/if}}
{{#if rest.length}}
<div class="card shadow-sm mt-4">
  <div class="card-header bg-white"><h2 class="h5 mb-0">Ранее отклонённые</h2></div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>Дата</th><th>Сотрудник</th><th>Событие</th><th>ID в CRM</th><th>Причина</th></tr></thead>
      <tbody>
        {{#each rest}}
        <tr><td class="text-nowrap">{{date}}</td><td>{{employeeName}}</td><td>{{typeLabel}}</td><td><code>{{crmId}}</code></td><td>{{reason}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{/if}}
{{> footer}}